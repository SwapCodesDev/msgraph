# ==============================================================================
# Microsoft Graph API Configuration
# ==============================================================================

# Authentication Flow:
#   - "device_code" : Delegated login via browser code (best for personal Microsoft accounts or interactive CLI).
#   - "client_credentials" : Headless daemon using client secret (best for automated services / enterprise cron jobs).
AUTH_FLOW=device_code

# Azure App Registration details (from Azure Entra ID portal):
AZURE_CLIENT_ID=your-azure-client-id-here

# Required ONLY for AUTH_FLOW=client_credentials (keep secret!):
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# Tenant ID:
#   - "common" : Multi-tenant or personal Microsoft accounts (Outlook / Hotmail / OneDrive personal)
#   - "consumers" : Personal Microsoft accounts only
#   - "organizations" : Work / School accounts only
#   - Or your Directory (tenant) GUID (e.g. 11111111-2222-3333-4444-555555555555)
AZURE_TENANT_ID=common

# Target Excel file path in OneDrive or SharePoint Document Library:
# (e.g., "my-app/data.xlsx", "reports/weekly.xlsx", or "data.xlsx")
EXCEL_FILE_PATH=my-app/data.xlsx

# Drive Target Type:
#   - "me"    : /me/drive (Delegated flow: the signed-in user's OneDrive)
#   - "user"  : /users/{TARGET_USER_ID}/drive (Daemon flow accessing specific user)
#   - "site"  : /sites/{TARGET_SITE_ID}/drive (SharePoint site library)
#   - "drive" : /drives/{TARGET_DRIVE_ID} (Direct Drive ID)
DRIVE_TARGET=me

# Target user/site/drive identifiers (required only if DRIVE_TARGET is not "me"):
TARGET_USER_ID=
TARGET_SITE_ID=
TARGET_DRIVE_ID=
